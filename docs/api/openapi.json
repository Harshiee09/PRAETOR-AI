{
  "openapi": "3.1.0",
  "info": {
    "title": "PRAETOR AI",
    "description": "Informational Indian-law answers grounded in cited sources. Not legal advice.",
    "version": "0.3.0"
  },
  "paths": {
    "/v1/ask": {
      "post": {
        "summary": "Answer a question from the indexed sources, with citations",
        "operationId": "ask_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources/{chunk_id}": {
      "get": {
        "summary": "The full stored passage behind a citation card",
        "operationId": "source_v1_sources__chunk_id__get",
        "parameters": [
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chunk Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/v1/healthz": {
      "get": {
        "summary": "Liveness and readiness (no key needed)",
        "operationId": "healthz_v1_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats": {
      "get": {
        "summary": "Corpus, index, model and server counters",
        "operationId": "stats_v1_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "description": "The user's question, in any supported language."
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "hybrid_rerank",
              "hybrid",
              "dense",
              "keyword"
            ],
            "title": "Mode",
            "description": "Retrieval configuration; keep `full` in production.",
            "default": "full"
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "description": "Include per-stage retrieval ranks, timings and validator details.",
            "default": false
          },
          "use_cache": {
            "type": "boolean",
            "title": "Use Cache",
            "description": "Reuse a cached answer for the same question and system version.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer_markdown": {
            "type": "string",
            "title": "Answer Markdown",
            "description": "Markdown answer. A high-stakes answer starts with a safety block."
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained",
            "description": "True when the system declined to answer (thin evidence or a refused request)."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Deterministic notes to show with the answer: repeal, transition, state-law coverage, removed sentences."
          },
          "jurisdiction_note": {
            "type": "string",
            "title": "Jurisdiction Note"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "description": "Show once with every answer."
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "description": "Equals the X-Request-ID response header."
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "`ollama`, `extractive` (no model; verbatim passages) or null."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "explain": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explain"
          }
        },
        "type": "object",
        "required": [
          "answer_markdown",
          "language",
          "confidence",
          "abstained",
          "citations",
          "warnings",
          "jurisdiction_note",
          "disclaimer",
          "trace_id",
          "provider",
          "classification",
          "latency_ms"
        ],
        "title": "AskResponse"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "The [S#] marker used in answer_markdown."
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Pass to GET /v1/sources/{chunk_id} for the full passage."
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "locator": {
            "type": "string",
            "title": "Locator",
            "description": "Where in the source: `s. 106`, `paras 12-15`, `pp. 8-9`."
          },
          "authority": {
            "type": "string",
            "title": "Authority"
          },
          "jurisdiction": {
            "type": "string",
            "title": "Jurisdiction",
            "description": "`IN` for central law; ISO 3166-2 code for a state amendment."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "`in_force`, `repealed`, `partially_in_force` or `n/a` (judgments)."
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "Verbatim excerpt (<= 300 characters) cut from the stored text in code."
          },
          "section_heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Heading"
          },
          "court": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "decision_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Date"
          },
          "citation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation",
            "description": "Neutral or reporter citation as printed in the source record."
          }
        },
        "type": "object",
        "required": [
          "id",
          "chunk_id",
          "title",
          "locator",
          "authority",
          "jurisdiction",
          "status",
          "source_url",
          "retrieved_at",
          "quote"
        ],
        "title": "Citation"
      },
      "Classification": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "intent": {
            "type": "string",
            "title": "Intent"
          },
          "high_stakes": {
            "type": "boolean",
            "title": "High Stakes"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "intent",
          "high_stakes"
        ],
        "title": "Classification"
      },
      "Error": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "Error"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "description": "`degraded`: no answer model, so answers fall back to verbatim passages; `down`: the index is unusable."
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Health"
      },
      "Source": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "doc_type": {
            "type": "string",
            "title": "Doc Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "locator": {
            "type": "string",
            "title": "Locator"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The full stored passage."
          },
          "authority": {
            "type": "string",
            "title": "Authority"
          },
          "jurisdiction": {
            "type": "string",
            "title": "Jurisdiction"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "licence": {
            "type": "string",
            "title": "Licence"
          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Start"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page End"
          },
          "act_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Act Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "section_heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Heading"
          },
          "case_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Title"
          },
          "court": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "decision_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Date"
          },
          "citation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "doc_type",
          "title",
          "locator",
          "text",
          "authority",
          "jurisdiction",
          "status",
          "language",
          "source_url",
          "retrieved_at",
          "licence"
        ],
        "title": "Source"
      },
      "Stats": {
        "properties": {
          "documents": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Documents"
          },
          "chunks": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Chunks"
          },
          "index": {
            "additionalProperties": true,
            "type": "object",
            "title": "Index"
          },
          "model": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "cache_entries": {
            "type": "integer",
            "title": "Cache Entries"
          },
          "uptime_s": {
            "type": "integer",
            "title": "Uptime S"
          },
          "requests": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Requests"
          },
          "answer_latency_ms": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Answer Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "documents",
          "chunks",
          "index",
          "model",
          "prompt_version",
          "cache_entries",
          "uptime_s",
          "requests",
          "answer_latency_ms"
        ],
        "title": "Stats"
      }
    }
  }
}
