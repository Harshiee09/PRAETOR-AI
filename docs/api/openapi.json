          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      },
      "delete": {
        "summary": "Forget an uploaded document now",
        "operationId": "delete_document_v1_documents__document_id__delete",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/v1/documents/analyze": {
      "post": {
        "summary": "Ask about, summarise, review, make a checklist or lawyer questions from, or compare documents",
        "operationId": "analyze_documents_v1_documents_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/healthz": {
      "get": {
        "summary": "Liveness and readiness (no key needed)",
        "operationId": "healthz_v1_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats": {
      "get": {
        "summary": "Corpus, index, model and server counters",
        "operationId": "stats_v1_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "document_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 1,
            "title": "Document Ids",
            "description": "One document; two for `compare`."
          },
          "task": {
            "type": "string",
            "enum": [
              "ask",
              "summary",
              "risks",
              "checklist",
              "lawyer_questions",
              "compare"
            ],
            "title": "Task",
            "description": "`ask` (needs `question`), `summary`, `risks` (clauses, obligations, risks, inconsistencies, comparison with the law), `checklist`, `lawyer_questions`, `compare` (two documents).",
            "default": "ask"
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Question",
            "description": "Required for `ask`; optional focus for the rest."
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "document_ids"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "answer_markdown": {
            "type": "string",
            "title": "Answer Markdown",
            "description": "Markdown answer. A high-stakes answer starts with a safety block."
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained",
            "description": "True when the system declined to answer (thin evidence or a refused request)."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Deterministic notes to show with the answer: repeal, transition, state-law coverage, removed sentences."
          },
          "jurisdiction_note": {
            "type": "string",
            "title": "Jurisdiction Note"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "description": "Show once with every answer."
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "description": "Equals the X-Request-ID response header."
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "`ollama`, `extractive` (no model; verbatim passages) or null."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "explain": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explain"
          },
          "task": {
            "type": "string",
            "enum": [
              "ask",
              "summary",
              "risks",
              "checklist",
              "lawyer_questions",
              "compare"
            ],
            "title": "Task"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Coverage"
            },
            "type": "array",
            "title": "Documents"
          },
          "law_checked": {
            "type": "boolean",
            "title": "Law Checked",
            "description": "True when Indian law passages were searched for (they are added only if they pass the evidence gate)."
          }
        },
        "type": "object",
        "required": [
          "answer_markdown",
          "language",
          "confidence",
          "abstained",
          "citations",
          "warnings",
          "jurisdiction_note",
          "disclaimer",
          "trace_id",
          "provider",
          "classification",
          "latency_ms",
          "task",
          "documents",
          "law_checked"
        ],
        "title": "AnalyzeResponse"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "description": "The user's question, in any supported language."
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "hybrid_rerank",
              "hybrid",
              "dense",
              "keyword"
            ],
            "title": "Mode",
            "description": "Retrieval configuration; keep `full` in production.",
            "default": "full"
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "description": "Include per-stage retrieval ranks, timings and validator details.",
            "default": false
          },
          "use_cache": {
            "type": "boolean",
            "title": "Use Cache",
            "description": "Reuse a cached answer for the same question and system version.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer_markdown": {
            "type": "string",
            "title": "Answer Markdown",
            "description": "Markdown answer. A high-stakes answer starts with a safety block."
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained",
            "description": "True when the system declined to answer (thin evidence or a refused request)."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Deterministic notes to show with the answer: repeal, transition, state-law coverage, removed sentences."
          },
          "jurisdiction_note": {
            "type": "string",
            "title": "Jurisdiction Note"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "description": "Show once with every answer."
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "description": "Equals the X-Request-ID response header."
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "`ollama`, `extractive` (no model; verbatim passages) or null."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "explain": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explain"
          }
        },
        "type": "object",
        "required": [
          "answer_markdown",
          "language",
          "confidence",
          "abstained",
          "citations",
          "warnings",
          "jurisdiction_note",
          "disclaimer",
          "trace_id",
          "provider",
          "classification",
          "latency_ms"
        ],
        "title": "AskResponse"
      },
      "Body_upload_v1_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "A PDF with a text layer (scanned PDFs need OCR, not installed)."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_documents_post"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "The marker used in answer_markdown: [S#] for law, [D#] for the user's own document."
          },
          "kind": {
            "type": "string",
            "enum": [
              "law",
              "document"
            ],
            "title": "Kind",
            "description": "`document`: a passage of an uploaded document; its full text is in GET /v1/documents/{document_id}.",
            "default": "law"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Law: pass to GET /v1/sources/{chunk_id}. Document: `<document_id>:<passage n>`."
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "locator": {
            "type": "string",
            "title": "Locator",
            "description": "Where in the source: `s. 106`, `paras 12-15`, `pp. 8-9`."
          },
          "authority": {
            "type": "string",
            "title": "Authority"
          },
          "jurisdiction": {
            "type": "string",
            "title": "Jurisdiction",
            "description": "`IN` for central law; ISO 3166-2 code for a state amendment."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "`in_force`, `repealed`, `partially_in_force` or `n/a` (judgments)."
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "Verbatim excerpt (<= 300 characters) cut from the stored text in code."
          },
          "section_heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Heading"
          },
          "court": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "decision_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Date"
          },
          "citation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation",
            "description": "Neutral or reporter citation as printed in the source record."
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id",
            "description": "Uploaded document the passage comes from (kind `document`)."
          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Start"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page End"
          }
        },
        "type": "object",
        "required": [
          "id",
          "chunk_id",
          "title",
          "locator",
          "authority",
          "jurisdiction",
          "status",
          "source_url",
          "retrieved_at",
          "quote"
        ],
        "title": "Citation"
      },
      "Classification": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "intent": {
