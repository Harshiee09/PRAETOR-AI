   "page": 7,
   "x0": 72.024,
   "x1": 393.76,
   "top": 508.054,
   "size": 9.0,
   "bold_prefix": "",
   "markers": []
  },
  {
   "text": "4. Subs. by the A.O. 1937, for the original paragraph.",
   "page": 7,
   "x0": 72.024,
   "x1": 292.93500000000006,
   "top": 517.294,
   "size": 9.0,
   "bold_prefix": "",
   "markers": []
  },
  {
