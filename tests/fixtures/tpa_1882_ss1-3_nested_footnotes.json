   "x0": 90.024,
   "x1": 353.7696,
   "top": 373.47463999999997,
   "size": 11.0,
   "bold_prefix": "",
   "markers": []
  },
  {
   "text": "1. Subs. by the A.O. 1950, for the third paragraph.",
   "page": 7,
   "x0": 72.024,
   "x1": 282.87899999999996,
   "top": 399.094,
   "size": 9.0,
   "bold_prefix": "",
   "markers": []
  },
  {
