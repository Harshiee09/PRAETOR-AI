   "top": 418.654,
   "size": 9.0,
   "bold_prefix": "",
   "markers": []
  },
  {
   "text": "Tract, by notification under s. 2 of the Assam Frontier Tracts Regulation, 1880 (Reg. 2 of 1880).",
   "page": 7,
   "x0": 81.024,
   "x1": 476.719,
   "top": 428.37399999999997,
   "size": 9.0,
   "bold_prefix": "",
   "markers": []
  },
